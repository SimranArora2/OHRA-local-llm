# snmp honeypot
FROM python:3.13-slim-bookworm

WORKDIR /app

RUN pip3 install --no-cache-dir requests twisted scapy

RUN addgroup --system appgroup && adduser --system appuser --ingroup appgroup --disabled-password

USER appuser

COPY base_honeypot.py ./
COPY snmp_honeypot.py ./

ENTRYPOINT ["python3", "snmp_honeypot.py"]