# telnet honeypot
FROM python:3.13-slim-bookworm

WORKDIR /app

RUN pip3 install --no-cache-dir requests twisted

RUN addgroup --system appgroup && adduser --system appuser --ingroup appgroup --disabled-password

# RUN mkdir -p /app/session_data
# RUN chown appuser /app/session_data

USER appuser

COPY base_honeypot.py ./
COPY telnet_honeypot.py ./

ENTRYPOINT ["python3", "telnet_honeypot.py"]